{
  "name": "@zeroko-io/commons",
  "version": "0.1.0",
  "private": true,
  "description": "Zeroko's look, components, views and runner client, shared by its panels.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeroko-io/oss.git",
    "directory": "packages/commons"
  },
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./postcss.config": "./postcss.config.mjs",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./views/*": "./src/views/*.tsx",
    "./views/service/*": "./src/views/service/*.tsx",
    "./screens/*": "./src/screens/*.tsx"
  },
  "peerDependencies": {
    "next": ">=16.4.2",
    "react": ">=19.3.0",
    "react-dom": ">=19.3.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@zeroko/eslint-config": "*",
    "@zeroko/typescript-config": "*",
    "eslint": "^10",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
